# ====== Supabase (Project Settings > Database / API) ======
# Connection string "Transaction pooler" (port 6543) — dianjurkan untuk Vercel
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Kunci RAHASIA (service_role) — hanya untuk server, JANGAN dipakai di browser/diunggah ke GitHub
SUPABASE_SERVICE_ROLE_KEY=
# Kunci publik (anon) — dipakai browser admin untuk mengunggah ke Storage
SUPABASE_ANON_KEY=
SUPABASE_BUCKET=uploads

# ====== Aplikasi ======
# Wajib di production: teks acak panjang (buat dengan: openssl rand -hex 32)
SESSION_SECRET=
# Akun admin awal untuk "npm run db:setup" (jika kosong: admin / admin123)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Opsional
PORT=3000
# Cache halaman publik di CDN Vercel (detik). 0 = mati. Perubahan admin baru tampil setelah waktu ini.
PAGE_CACHE_SECONDS=0
# Hanya untuk server lokal tanpa SSL ke database (mis. Postgres di komputer sendiri): PGSSL=disable
