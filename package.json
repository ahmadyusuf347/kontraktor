{
  "name": "kontraktor-website",
  "version": "1.0.0",
  "private": true,
  "description": "Website profil kontraktor + dashboard admin (Express, EJS, Tailwind CSS, Supabase) — siap deploy di Vercel",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "vendor": "node scripts/copy-vendor.js",
    "css": "tailwindcss -i ./src/input.css -o ./public/css/app.css --minify",
    "css:watch": "tailwindcss -i ./src/input.css -o ./public/css/app.css --watch",
    "build": "npm run vendor && npm run css",
    "postinstall": "npm run build",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:schema": "node scripts/schema-sql.js",
    "db:setup": "node scripts/db-setup.js",
    "db:import": "node scripts/import-json.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "bcryptjs": "^2.4.3",
    "bootstrap-icons": "^1.11.3",
    "cookie-session": "^2.1.1",
    "dotenv": "^18.0.9",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "gsap": "^3.12.5",
    "helmet": "^8.0.0",
    "pg": "^8.23.1",
    "tailwindcss": "^3.4.17"
  }
}