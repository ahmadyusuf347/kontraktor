<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Kontraktor</title>
<meta name="description" content="<%= desc || S.metaDescription %>">
<meta property="og:title" content="<%= title ? title + ' – ' + S.siteName : S.siteName %>">
<meta property="og:description" content="<%= desc || S.metaDescription %>">
<meta property="og:type" content="website">
<link rel="icon" href="<%= S.logo || '/images/Logo.png' %>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.css">
<link rel="stylesheet" href="/css/app.css?v=<%= v %>">
<script src="/vendor/gsap.min.js" defer></script>
<script src="/vendor/ScrollTrigger.min.js" defer></script>
<script src="/js/site.js?v=<%= v %>" defer></script>
</head>
<body>
<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-white focus:text-black focus:px-3 focus:py-2 focus:rounded">Lewati ke konten</a>
<%
  const logoSrc = S.logo || '/images/Logo.png';
  const links = [['Home','/'],['About Us','/about'],['Project','/projects'],['Service','/services'],['Our Team','/team'],['News','/news'],['Contact','/contact']];
  const isActive = h => h === '/' ? path === '/' : path.startsWith(h);
%>
<div class="bg-white text-black text-[10px] sm:text-xs h-8">
  <div class="max-w-[1200px] mx-auto px-5 h-full flex items-center justify-end gap-6 sm:gap-10">
    <a href="tel:<%= (S.phone||'').replace(/\D/g,'') %>" class="hover:underline"><i class="bi bi-telephone me-1"></i><%= S.phone %></a>
    <span><i class="bi bi-geo-alt me-1"></i><%= S.city %></span>
  </div>
</div>
<div class="h-16 md:h-20 bg-black"></div>
<header id="header" data-dark="true" class="fixed left-0 right-0 z-50 transition-colors duration-300 bg-black text-white" style="top:32px">
  <div class="max-w-[1200px] mx-auto px-5 h-16 md:h-20 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2" aria-label="<%= S.siteName %> – beranda">
      <%- logo('dark', 36, 44) %>
    </a>
    <nav class="hidden lg:flex items-center gap-5 xl:gap-7 text-sm xl:text-[15px]" aria-label="Menu utama">
      <% links.forEach(([t,h]) => { %><a href="<%= h %>" class="whitespace-nowrap transition-opacity <%= isActive(h) ? 'font-semibold underline underline-offset-8 decoration-2' : 'opacity-80 hover:opacity-100' %>"><%= t %></a><% }) %>
    </nav>
    <div class="flex items-center gap-3">
      <%- pill("Let's Talk", '/contact', 'light', 'hidden sm:inline-flex') %>
      <button id="menuBtn" class="lg:hidden w-10 h-10 grid place-items-center text-2xl" aria-label="Buka menu" aria-expanded="false"><i class="bi bi-list"></i></button>
    </div>
  </div>
</header>
<div id="overlay" class="lg:hidden fixed inset-0 bg-black/60 z-[60]" style="visibility:hidden;opacity:0"></div>
<nav id="mobileNav" class="lg:hidden fixed top-0 left-0 bottom-0 w-[80%] max-w-xs bg-black text-white border-r border-white/10 z-[70] flex flex-col px-6 py-5" style="visibility:hidden" aria-label="Menu mobile" aria-hidden="true">
  <div class="flex items-center justify-between mb-8">
    <%- logo('dark', 32) %>
    <button id="closeBtn" class="w-10 h-10 grid place-items-center text-2xl -mr-2" aria-label="Tutup menu"><i class="bi bi-x-lg"></i></button>
  </div>
  <ul class="flex flex-col text-lg divide-y divide-white/10">
    <% links.forEach(([t,h]) => { %><li><a class="block py-3.5 <%= isActive(h) ? 'font-semibold' : 'text-white/70' %>" href="<%= h %>"><%= t %></a></li><% }) %>
  </ul>
  <div class="mt-8" data-drawer-cta><%- pill("Let's Talk", '/contact', 'light', 'gap-6') %></div>
  <p class="mt-auto text-xs text-white/50"><%= S.phone %> · <%= S.city %></p>
</nav>
<% if (!dark) { %><div class="hero-bg"><% } %>
