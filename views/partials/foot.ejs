</main>
<%
  const fServices = footerServices;
  const fLinks = [['Home','/'],['About us','/about'],['Project','/projects'],['Service','/services'],['Our Team','/team'],['News','/news'],['Contact','/contact']];
%>
<footer class="bg-neutral-900 text-white">
  <div class="max-w-[1200px] mx-auto px-5 pt-16 md:pt-24">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-[1.2fr_1fr_1fr_1fr] lg:gap-0">
      <div class="flex flex-col gap-6 lg:pr-10">
        <a href="/" class="flex items-center gap-2" aria-label="<%= S.siteName %>">
          <%- logo('dark', 'h-10 md:h-12', 'text-2xl') %>
        </a>
        <p class="text-sm text-white/60 max-w-xs leading-relaxed"><%= S.footerText %></p>
        <div>
          <p class="text-lg font-semibold">Follow Us :</p>
          <div class="flex gap-4 mt-3 text-2xl">
            <a href="<%= S.instagram || '#' %>" aria-label="Instagram" class="text-white/80 hover:text-white"><i class="bi bi-instagram"></i></a>
            <a href="<%= S.facebook || '#' %>" aria-label="Facebook" class="text-white/80 hover:text-white"><i class="bi bi-facebook"></i></a>
            <a href="<%= S.youtube || '#' %>" aria-label="YouTube" class="text-white/80 hover:text-white"><i class="bi bi-youtube"></i></a>
          </div>
        </div>
      </div>
      <div class="lg:border-l border-white/20 lg:pl-10">
        <h4 class="text-lg font-semibold">Service</h4>
        <ul class="mt-4 space-y-3 text-white/70 font-light">
          <% fServices.forEach((s,i) => { %><li class="flex items-center gap-2"><i class="w-1.5 h-1.5 rounded-full <%= i===0 ? 'bg-white' : 'bg-transparent' %>"></i><a href="/services" class="hover:text-white"><%= s.title %></a></li><% }) %>
        </ul>
      </div>
      <div class="lg:border-l border-white/20 lg:pl-10">
        <h4 class="text-lg font-semibold">Menu</h4>
        <ul class="mt-4 space-y-3 text-white/70 font-light">
          <% fLinks.forEach(([t,h],i) => { %><li class="flex items-center gap-2"><i class="w-1.5 h-1.5 rounded-full <%= i===0 ? 'bg-white' : 'bg-transparent' %>"></i><a href="<%= h %>" class="hover:text-white"><%= t %></a></li><% }) %>
        </ul>
      </div>
      <div class="lg:border-l border-white/20 lg:pl-10">
        <h4 class="text-lg font-semibold">Kontak</h4>
        <ul class="mt-4 space-y-3 text-white/70 font-light text-sm">
          <li class="flex gap-3"><i class="bi bi-geo-alt"></i><span><%= S.address %></span></li>
          <li class="flex gap-3"><i class="bi bi-telephone"></i><a href="tel:<%= (S.phone||'').replace(/\D/g,'') %>" class="hover:text-white"><%= S.phone %></a></li>
          <li class="flex gap-3"><i class="bi bi-envelope"></i><a href="mailto:<%= S.email %>" class="underline hover:text-white break-all"><%= S.email %></a></li>
        </ul>
      </div>
    </div>
    <div class="mt-14 border-t border-white/20 py-6 text-xs text-white/50 flex flex-wrap justify-between gap-2">
      <span>© <%= new Date().getFullYear() %> <%= S.siteName %>. All rights reserved.</span><a href="/admin" class="hover:text-white">Admin</a>
    </div>
  </div>
</footer>
<a href="https://wa.me/<%= S.whatsapp %>" target="_blank" rel="noopener" aria-label="Chat WhatsApp" class="fixed bottom-5 right-5 z-40 w-12 h-12 rounded-full bg-black text-white border border-white/30 shadow-lg grid place-items-center text-2xl hover:bg-neutral-700 transition-colors"><i class="bi bi-whatsapp"></i></a>
<button id="toTop" aria-label="Kembali ke atas" class="fixed bottom-5 right-20 z-40 w-12 h-12 rounded-full bg-white text-black border border-neutral-300 shadow-lg hidden place-items-center text-xl hover:bg-neutral-100"><i class="bi bi-arrow-up"></i></button>
</body>
</html>
