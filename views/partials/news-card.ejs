<article class="news bg-white rounded-3xl overflow-hidden border border-neutral-900 flex flex-col <%= locals.cls || '' %>">
  <a href="/news/<%= n.slug %>" class="block h-44 sm:h-52 lg:h-[198px] overflow-hidden bg-neutral-200" tabindex="-1" aria-hidden="true">
    <%- media(n.image, n.title, 'w-full h-full object-cover hover:scale-105 transition-transform duration-500') %>
  </a>
  <div class="p-6 flex flex-col flex-1">
    <time class="text-sm text-neutral-600" datetime="<%= n.date %>"><%= fmtDate(n.date) %></time>
    <h3 class="mt-3 text-2xl font-semibold leading-tight tracking-tight"><a href="/news/<%= n.slug %>"><%= n.title %></a></h3>
    <p class="mt-2 text-sm leading-snug text-neutral-700 line-clamp-4"><%= n.excerpt %></p>
    <a href="/news/<%= n.slug %>" class="mt-auto pt-6 text-sm underline self-end">Baca selengkapnya</a>
  </div>
</article>
