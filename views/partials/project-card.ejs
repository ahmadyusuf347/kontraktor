<article class="proj rounded-3xl overflow-hidden border border-neutral-900 bg-white" data-cat="<%= p.category %>">
  <div class="h-52 overflow-hidden bg-neutral-200"><%- media(p.image, p.title, 'w-full h-full object-cover hover:scale-105 transition-transform duration-500', 'bi-building') %></div>
  <div class="p-6">
    <span class="inline-block text-xs border border-neutral-900 rounded-full px-3 py-0.5"><%= p.category %></span>
    <h3 class="mt-3 text-xl font-semibold tracking-tight"><%= p.title %></h3>
    <p class="mt-1 text-sm text-neutral-600"><% if (p.location) { %><i class="bi bi-geo-alt me-1"></i><%= p.location %><% } %><% if (p.year) { %> · <%= p.year %><% } %></p>
  </div>
</article>
