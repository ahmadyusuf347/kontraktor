<%- include('../partials/head') %>
<%- include('../partials/hero', { heading: 'Contact' }) %>
<section class="py-12 md:py-20">
  <div class="max-w-[1200px] mx-auto px-5 grid lg:grid-cols-5 gap-10 lg:gap-16">
    <div class="lg:col-span-2">
      <h2 class="text-3xl md:text-5xl font-semibold tracking-[-0.045em]">Hubungi Kami</h2>
      <p class="mt-4 text-neutral-700 leading-relaxed"><%= S.ctaTitle %>. Ceritakan kebutuhan proyek Anda dan tim kami akan menghubungi Anda secepatnya.</p>
      <ul class="mt-8 space-y-5">
        <li class="flex gap-4"><span class="w-11 h-11 rounded-full bg-black text-white grid place-items-center shrink-0"><i class="bi bi-geo-alt"></i></span><div><p class="font-semibold">Alamat</p><p class="text-neutral-700"><%= S.address %></p></div></li>
        <li class="flex gap-4"><span class="w-11 h-11 rounded-full bg-black text-white grid place-items-center shrink-0"><i class="bi bi-telephone"></i></span><div><p class="font-semibold">Telepon</p><a class="text-neutral-700 hover:underline" href="tel:<%= (S.phone||'').replace(/\D/g,'') %>"><%= S.phone %></a></div></li>
        <li class="flex gap-4"><span class="w-11 h-11 rounded-full bg-black text-white grid place-items-center shrink-0"><i class="bi bi-envelope"></i></span><div><p class="font-semibold">Email</p><a class="text-neutral-700 hover:underline break-all" href="mailto:<%= S.email %>"><%= S.email %></a></div></li>
      </ul>
      <div class="mt-8"><%- pill('Chat via WhatsApp', 'https://wa.me/' + S.whatsapp, 'dark', 'gap-6') %></div>
    </div>
    <form method="post" action="/contact" class="lg:col-span-3 border border-neutral-900 rounded-3xl p-6 md:p-10 space-y-5" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="hidden" aria-hidden="true"><label>Website <input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>
      <% if (errors.length) { %><div class="rounded-lg border border-neutral-900 bg-neutral-100 px-4 py-3 text-sm" role="alert"><ul class="list-disc ps-5"><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul></div><% } %>
      <div class="grid sm:grid-cols-2 gap-5">
        <div><label for="name" class="block text-sm font-medium mb-1.5">Nama *</label><input id="name" name="name" class="fld" value="<%= form.name || '' %>" required autocomplete="name"></div>
        <div><label for="phone" class="block text-sm font-medium mb-1.5">Telepon</label><input id="phone" name="phone" class="fld" value="<%= form.phone || '' %>" autocomplete="tel"></div>
      </div>
      <div><label for="email" class="block text-sm font-medium mb-1.5">Email *</label><input id="email" type="email" name="email" class="fld" value="<%= form.email || '' %>" required autocomplete="email"></div>
      <div><label for="message" class="block text-sm font-medium mb-1.5">Pesan *</label><textarea id="message" name="message" rows="6" class="fld" required><%= form.message || '' %></textarea></div>
      <button class="btn w-full sm:w-auto px-8 py-3"><i class="bi bi-send"></i> Kirim Pesan</button>
    </form>
  </div>
</section>
<%- include('../partials/foot') %>
