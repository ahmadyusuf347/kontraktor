<%- include('../partials/head') %>
<%- include('../partials/hero', { heading: 'News' }) %>
<section class="bg-neutral-200 py-12 md:py-20">
  <div class="max-w-[1200px] mx-auto px-5">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 lg:gap-9"><% items.forEach(n => { %><div data-reveal class="flex"><%- include('../partials/news-card', { n, cls: 'w-full' }) %></div><% }) %></div>
    <% if (!items.length) { %><p class="text-center text-neutral-500">Belum ada berita.</p><% } %>
    <% if (pages > 1) { %>
    <nav class="mt-12 flex justify-center gap-2" aria-label="Halaman">
      <% for (let i = 1; i <= pages; i++) { %><a href="/news?page=<%= i %>" class="w-10 h-10 grid place-items-center rounded-full border border-neutral-900 text-sm <%= i === page ? 'bg-black text-white' : 'bg-white hover:bg-neutral-100' %>" <%- i === page ? 'aria-current="page"' : '' %>><%= i %></a><% } %>
    </nav>
    <% } %>
  </div>
</section>
<%- include('../partials/foot') %>
