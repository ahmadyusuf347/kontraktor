<%- include('../partials/head') %>
<%- include('../partials/hero', { heading: 'Our Team' }) %>
<section class="py-14 md:py-24">
  <div class="max-w-[1200px] mx-auto px-5">
    <h2 class="text-center text-3xl sm:text-4xl md:text-6xl font-semibold tracking-[-0.045em] mb-12 md:mb-24">Team <%= S.siteName %></h2>
    <div class="flex flex-wrap justify-center gap-4 sm:gap-6 lg:gap-[26px] md:px-4">
      <% team.forEach(m => { %>
      <article data-reveal class="w-[calc(50%-8px)] sm:w-[calc(33.333%-16px)] lg:w-[calc(20%-21px)] bg-white">
        <div class="aspect-[239/322] overflow-hidden bg-neutral-200"><%- media(m.photo, m.name, 'w-full h-full object-cover', 'bi-person') %></div>
        <div class="relative h-[62px] sm:h-[70px] border-b border-neutral-300 flex flex-col justify-center pl-3 sm:pl-5 pr-14 sm:pr-16">
          <h3 class="text-sm sm:text-lg font-medium leading-tight tracking-tight truncate"><%= m.name %></h3>
          <p class="text-[10px] sm:text-xs text-neutral-600 leading-tight truncate"><%= m.role %></p>
          <span class="tri-br absolute right-0 bottom-0 w-12 h-[62px] sm:w-[70px] sm:h-[70px] bg-black"></span>
        </div>
      </article>
      <% }) %>
    </div>
  </div>
</section>
<%- include('../partials/foot') %>
