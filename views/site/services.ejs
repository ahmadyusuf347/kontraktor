<%- include('../partials/head') %>
<%- include('../partials/hero', { heading: 'Services' }) %>
<section class="py-12 md:py-20">
  <h2 class="text-center text-4xl md:text-6xl font-semibold tracking-[-0.045em] mb-10 md:mb-14">Services</h2>
  <div class="space-y-10 md:space-y-8">
    <% services.forEach((s,i) => { const rev = i % 2 === 1; %>
    <section data-reveal>
      <div class="max-w-[1200px] mx-auto px-5 md:px-10 mb-3 md:mb-4"><h3 class="text-2xl md:text-3xl font-semibold tracking-tight <%= rev ? 'md:text-right' : '' %>"><i class="bi <%= s.icon %> me-2"></i><%= s.title %></h3></div>
      <div class="bg-gradient-to-b <%= rev ? 'md:bg-gradient-to-l' : 'md:bg-gradient-to-r' %> from-neutral-200 via-neutral-400 to-neutral-800 md:from-neutral-100 md:via-neutral-300 md:via-55% md:to-neutral-800">
        <div class="max-w-[1200px] mx-auto px-5 md:px-10 py-8 md:py-6 flex flex-col <%= rev ? 'md:flex-row-reverse' : 'md:flex-row' %> items-center gap-8 md:gap-12">
          <div class="md:flex-1 text-sm md:text-base leading-snug text-justify md:py-10 order-2 md:order-none prose-lite text-neutral-900"><%- paragraphs(s.description) %></div>
          <div class="shrink-0 w-64 h-64 sm:w-72 sm:h-72 lg:w-[340px] lg:h-[340px] rounded-full border-[10px] border-neutral-900 bg-white p-1.5 md:-my-8 order-1 md:order-none overflow-hidden">
            <%- media(s.image, s.title, 'w-full h-full rounded-full object-cover', s.icon) %>
          </div>
        </div>
      </div>
    </section>
    <% }) %>
  </div>
</section>
<section class="bg-neutral-100 py-20 md:py-28 text-center">
  <div class="max-w-[1200px] mx-auto px-5">
    <h2 class="font-extrabold tracking-[-0.045em] leading-[1.05] text-4xl sm:text-5xl md:text-6xl max-w-3xl mx-auto"><%= S.ctaTitle %></h2>
    <div class="mt-10 flex justify-center"><%- pill('WhatsApp', 'https://wa.me/' + S.whatsapp, 'dark', 'text-lg md:text-xl pl-8 pr-1.5 py-1.5 gap-16') %></div>
  </div>
</section>
<%- include('../partials/foot') %>
