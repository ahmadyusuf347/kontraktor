<%- include('partials/top') %>
<form method="post" action="/admin/account" class="max-w-xl bg-white rounded-2xl border border-neutral-200 p-5 md:p-8 space-y-5">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% if (errors.length) { %><div class="rounded-lg border border-black bg-neutral-100 px-4 py-3 text-sm" role="alert"><ul class="list-disc ps-5"><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul></div><% } %>
  <div><label class="block text-sm font-medium mb-1.5" for="un">Username</label><input id="un" name="username" class="fld" value="<%= username %>" required></div>
  <div><label class="block text-sm font-medium mb-1.5" for="np">Password baru</label><input id="np" type="password" name="password" class="fld" autocomplete="new-password" placeholder="Kosongkan jika tidak diganti"><p class="mt-1.5 text-xs text-neutral-500">Minimal 8 karakter.</p></div>
  <div><label class="block text-sm font-medium mb-1.5" for="cp">Konfirmasi password baru</label><input id="cp" type="password" name="confirm" class="fld" autocomplete="new-password"></div>
  <div class="pt-4 border-t border-neutral-200"><label class="block text-sm font-medium mb-1.5" for="cur">Password saat ini *</label><input id="cur" type="password" name="current" class="fld" autocomplete="current-password" required></div>
  <button class="btn"><i class="bi bi-check-lg"></i> Simpan perubahan</button>
</form>
<%- include('partials/bottom') %>
